#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        td: MyTapDance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        th: MyTapHold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        skq: MyStickyKeyQuickRelease {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };

        auto_mouse_layer_config {
            compatible = "zmk,behavior-auto-mouse-layer";
            mac-base-layer = <0>;
            mac-mouse-layer = <3>;
            windows-base-layer = <4>;
            windows-mouse-layer = <7>;
        };

        HID_DragScroll: HID_DragScroll {
            compatible = "zmk,behavior-raw-drag-scroll";
            #binding-cells = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo_Macro_M10 {
            bindings = <&Macro_M10>;
            key-positions = <1 25>;
            layers = <2 6>;
        };

        Combo_Macro_M11 {
            bindings = <&Macro_M11>;
            key-positions = <26 2>;
            layers = <2 6>;
        };

        Combo_Macro_M12 {
            bindings = <&Macro_M12>;
            key-positions = <33 9>;
            layers = <1 5>;
        };

        Combo_Macro_M13 {
            bindings = <&Macro_M13>;
            key-positions = <10 34>;
            layers = <1 5>;
        };

        Combo_BrightnessUp_Mac {
            bindings = <&kp LC(LS(LA(LG(F10))))>;
            key-positions = <6 18>;
            layers = <0 4>;
        };

        Combo_BrightnessDown_Mac {
            bindings = <&kp LC(LS(LA(LG(F11))))>;
            key-positions = <30 18>;
            layers = <0 4>;
        };

        Combo_BrightnessUp_Win {
            bindings = <&kp C_BRI_UP>;
            key-positions = <6 18>;
            layers = <1 5>;
        };

        Combo_BrightnessDown_Win {
            bindings = <&kp C_BRI_DN>;
            key-positions = <30 18>;
            layers = <1 5>;
        };

        Combo_VolumeUp {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 17>;
            layers = <0 4>;
        };

        Combo_VolumeDown {
            bindings = <&kp C_VOL_DN>;
            key-positions = <29 17>;
            layers = <0 4>;
        };

        Combo_Unlock {
            bindings = <&studio_unlock>;
            key-positions = <10 1>;
            layers = <0 4>;
        };
    };

    macros {
        // ------------------------------------------------------------- 
        // Macro for IDE (SSMS & VisualCoed)
        // ------------------------------------------------------------- 

        Macro_M00_Outline_CollapseAll: Macro_M00_Outline_CollapseAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp M &kp A>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M01_Outline_ToggleCurrent: Macro_M01_Outline_ToggleCurrent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp M &kp M>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M02_Outline_ExpandAll: Macro_M02_Outline_ExpandAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp M &kp L>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M03_Bookmark_Previous: Macro_M03_Bookmark_Previous {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp P>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M04_Bookmark_Toggle: Macro_M04_Bookmark_Toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp K>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M05_Bookmark_ClearAll: Macro_M05_Bookmark_ClearAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp L>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M06_Bookmark_Next: Macro_M06_Bookmark_Next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp N>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M07_Comment: Macro_M07_Comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp C>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M08_UnComment: Macro_M08_UnComment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp U>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_SetMac: Macro_SetMac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&bt BT_SEL 0 &to 0>;
        };

        Macro_SetWin: Macro_SetWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&bt BT_SEL 1 &to 4>;
        };

        Macro_SetiPad: Macro_SetiPad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&bt BT_SEL 2 &to 0>;
        };

        Macro_SetiPhone: Macro_SetiPhone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&bt BT_SEL 3 &to 0>;
        };

        // ------------------------------------------------------------- 
        // Password for local stuff
        // ------------------------------------------------------------- 

        Macro_M10: Macro_M10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp T &kp I &kp LS(A) &kp STAR &kp AMPS &kp N0 &kp E &kp N5 &kp N6 &kp U &kp UNDER &kp LS(H) &kp S &kp LS(D) &kp D &kp LS(D) &kp N5>;
        };

        Macro_M11: Macro_M11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp N9 &kp LS(P) &kp N0 &kp LS(S) &kp UNDER &kp N1 &kp E &kp U &kp LS(W) &kp COMMA &kp L &kp R &kp LS(U) &kp MINUS &kp UNDER &kp LS(N) &kp E>;
        };

        Macro_M12: Macro_M12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp N &kp N5 &kp MINUS &kp E &kp A &kp N7 &kp POUND &kp MINUS &kp N8 &kp F &kp N &kp POUND &kp MINUS &kp N4 &kp I &kp DLLR &kp POUND>;
        };

        Macro_M13: Macro_M13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(J) &kp N5 &kp LS(R) &kp UNDER &kp N3 &kp LS(T) &kp N5 &kp UNDER &kp N5 &kp N1 &kp N4 &kp N6 &kp N3 &kp N2 &kp N2 &kp N8 &kp N1 &kp N5>;
        };

        // ------------------------------------------------------------- 
        // Mouse
        // ------------------------------------------------------------- 

        LCLKx2: LCLKx2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &mkp LCLK>;
        };

        LED_DragScroll: LED_DragScroll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp SLCK>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp SLCK>;
        };
    };

    /*
        Symbol      Mac — ZMK                    Mac — QMK
        -------     ----------------------       ----------------------
        ~           &kp RA(RBKT)        RALT(KC_RBRC)
        /           &kp KP_DIVIDE                KC_KP_SLASH
        \           &kp RA(GRAVE)                RALT(KC_GRV)
        |           &kp RA(MINUS)                RALT(KC_MINS)


        Symbol      Win — ZMK                    Win — QMK
        -------     ----------------------       ----------------------
        ~           &kp RC(RBKT)        RCTL(KC_RBRC)
        /           &kp KP_DIVIDE                KC_KP_SLASH
        \           &kp LS(GRAVE)                LSFT(KC_GRV)
        |           &kp RA(GRAVE)                RALT(KC_GRV)
*/

    keymap {
        compatible = "zmk,keymap";

        Mac_Base_Layout_0 {
            label = "Apple";
            bindings = <
&none         &kp Q  &kp W  &kp F  &kp P  &kp B          &kp J      &kp L  &kp U      &kp Y    &kp RA(RBKT)  &none
&none         &kp A  &kp R  &kp S  &kp T  &kp G          &kp M      &kp N  &kp E      &kp I    &kp O         &none
&kp LC(LEFT)  &kp Z  &kp X  &kp C  &kp D  &kp V          &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH      &kp LC(RIGHT)
                            &mo 8  &mo 1  &skq LSHIFT    &kp SPACE  &mo 2  &mo 9
            >;
        };

        Mac_Extend_Layout_1 {
            label = "Extend";
            bindings = <
&none  &kp LG(Z)  &kp LG(X)    &kp LG(C)    &kp LG(V)   &kp LG(LS(Z))    &kp LG(LEFT)  &kp PG_DN  &kp PG_UP  &kp LG(RIGHT)  &kp PRINTSCREEN  &none
&none  &skq LALT  &skq LGUI    &skq LSHIFT  &skq LCTRL  &kp BSPC         &kp LEFT      &kp DOWN   &kp UP     &kp RIGHT      &kp ESC          &none
&none  &skq RALT  &kp LS(TAB)  &kp TAB      &skq RCTRL  &kp RET          &kp DEL       &kp BSPC   &kp TAB    &kp INS        &kp CAPS         &none
                               &none        &none       &none            &kp RET       &mo 10     &none
            >;
        };

        Mac_Symbol_Layout_2 {
            label = "Symbol";
            bindings = <
&none  &kp EXCL      &kp AT      &kp HASH           &kp DOLLAR  &kp PRCNT      &kp LS(N6)     &kp AMPS   &kp ASTRK      &kp PLUS   &kp RA(MINUS)  &none
&none  &kp BSLH      &kp RA(N7)  &th LS(LBKT) LBKT  &kp LPAR    &kp RA(N9)     &kp KP_DIVIDE  &kp MINUS  &kp RA(COMMA)  &kp COLON  &kp EQUAL      &none
&none  &kp RA(LBKT)  &kp RA(N8)  &kp RBKT           &kp RPAR    &kp RA(N0)     &kp RA(GRAVE)  &kp UNDER  &kp RA(DOT)    &kp SEMI   &kp APOS       &none
                                 &none              &mo 10      &skq LSHIFT    &none          &none      &mo 11
            >;
        };

        Mac_Mouse_Layout_3 {
            label = "Mouse";
            bindings = <
&none  &none     &none     &HID_DragScroll  &none         &none      &none  &none  &none  &none  &none  &none
&none  &kp LALT  &kp LGUI  &kp LSHFT        &kp LCTRL     &none      &none  &none  &none  &none  &none  &none
&none  &none     &none     &kp LG(LBKT)     &kp LG(RBKT)  &none      &none  &none  &none  &none  &none  &none
                           &mkp RCLK        &mkp LCLK     &LCLKx2    &none  &none  &none
            >;
        };

        Win_Base_Layout_4 {
            label = "Windows";
            bindings = <
&none             &kp Q  &kp W  &kp F  &kp P  &kp B          &kp J      &kp L  &kp U      &kp Y    &kp RC(RBKT)  &none
&none             &kp A  &kp R  &kp S  &kp T  &kp G          &kp M      &kp N  &kp E      &kp I    &kp O         &none
&kp LC(LG(LEFT))  &kp Z  &kp X  &kp C  &kp D  &kp V          &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH      &kp LC(LG(RIGHT))
                                &mo 8  &mo 5  &skq LSHIFT    &kp SPACE  &mo 6  &mo 9
            >;
        };

        Win_Extend_Layout_5 {
            label = "Extend";
            bindings = <
&none  &kp LC(Z)  &kp LC(X)    &kp LC(C)    &kp LC(V)   &kp LC(Y)    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp PRINTSCREEN  &none
&none  &skq LALT  &skq LGUI    &skq LSHIFT  &skq LCTRL  &kp BSPC     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp ESC          &none
&none  &skq RALT  &kp LS(TAB)  &kp TAB      &skq RCTRL  &kp RET      &kp DEL   &kp BSPC   &kp TAB    &kp INS    &kp CAPS         &none
                               &none        &none       &none        &kp RET   &mo 10     &none
            >;
        };

        Win_Symbol_Layout_6 {
            label = "Symbol";
            bindings = <
&none  &kp EXCL      &kp AT      &kp HASH           &kp DOLLAR  &kp PRCNT      &kp LS(N6)     &kp AMPS   &kp ASTRK      &kp PLUS   &kp RA(GRAVE)  &none
&none  &kp BSLH      &kp RA(N7)  &th LS(LBKT) LBKT  &kp LPAR    &kp RA(N9)     &kp KP_DIVIDE  &kp MINUS  &kp RA(COMMA)  &kp COLON  &kp EQUAL      &none
&none  &kp RA(LBKT)  &kp RA(N8)  &kp RBKT           &kp RPAR    &kp RA(N0)     &kp LS(GRAVE)  &kp UNDER  &kp RA(DOT)    &kp SEMI   &kp APOS       &none
                                 &none              &mo 10      &skq LSHIFT    &none          &none      &mo 11
            >;
        };

        Win_Mouse_Layout_7 {
            label = "Mouse";
            bindings = <
&none  &none     &none     &LED_DragScroll  &none          &none      &none  &none  &none  &none  &none  &none
&none  &kp LALT  &kp LGUI  &kp LSHFT        &kp LCTRL      &none      &none  &none  &none  &none  &none  &none
&none  &none     &none     &kp LA(LEFT)     &kp LA(RIGHT)  &none      &none  &none  &none  &none  &none  &none
                           &mkp RCLK        &mkp LCLK      &LCLKx2    &none  &none  &none
            >;
        };

        Num_Layout_8 {
            label = "Num";
            bindings = <
&none  &none     &none      &kp LC(LS(LA(LEFT_GUI)))  &none      &none    &none         &kp N7  &kp N8      &kp N9  &kp LNLCK        &none
&none  &kp LALT  &kp LGUI   &kp LSHIFT                &kp LCTRL  &none    &kp KP_MINUS  &kp N4  &kp N5      &kp N6  &kp KP_DIVIDE    &none
&none  &kp RALT  &kp GLOBE  &none                     &kp RCTRL  &none    &kp KP_PLUS   &kp N1  &kp N2      &kp N3  &kp KP_MULTIPLY  &none
                            &none                     &none      &none    &kp KP_ENTER  &kp N0  &kp KP_DOT
            >;
        };

        Fn_Layout_9 {
            label = "Fn";
            bindings = <
&none  &none     &none      &none       &none      &none    &none  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &kp LALT  &kp LGUI   &kp LSHIFT  &kp LCTRL  &none    &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &kp RALT  &kp GLOBE  &none       &kp RCTRL  &none    &none  &kp F1  &kp F2  &kp F3  &kp F12  &none
                            &none       &none      &none    &none  &mo 11  &none
            >;
        };

        Config_Layout_10 {
            label = "Config";
            bindings = <
&none  &none             &none           &none          &none          &none    &none  &none         &none         &none  &none  &none
&none  &Macro_SetiPhone  &Macro_SetiPad  &Macro_SetWin  &Macro_SetMac  &none    &none  &out OUT_BLE  &out OUT_USB  &none  &none  &none
&none  &none             &none           &none          &none          &none    &none  &none         &none         &none  &none  &none
                                         &none          &none          &none    &none  &none         &none
            >;
        };

        Reset_Layout_11 {
            label = "Reset";
            bindings = <
&none  &bootloader  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &bt BT_CLR   &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none        &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                           &none  &none  &none    &none  &none  &none
            >;
        };
    };
};
