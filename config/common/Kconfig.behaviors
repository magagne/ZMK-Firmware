config ZMK_BEHAVIOR_RAW_DRAG_SCROLL
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_RAW_DRAG_SCROLL_ENABLED
    depends on RAW_HID

config ZMK_BEHAVIOR_AUTO_MOUSE_LAYER
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_AUTO_MOUSE_LAYER_ENABLED
    depends on RAW_HID
    depends on ZMK_HID_INDICATORS

config ZMK_BEHAVIOR_AUTO_MOUSE_LAYER_TIMEOUT_MS
    int "AutoMouseLayer timeout"
    # Longer default is useful for debugging.
    default 700
    depends on ZMK_BEHAVIOR_AUTO_MOUSE_LAYER
    help
      Time in milliseconds after the last Ploopy AutoMouseLayer notification
      before the automatically activated Mouse layer is released.
